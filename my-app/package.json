{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "validate": "node validation/run.mjs",
    "validate:spec": "node validation/run.mjs extract-spec",
    "validate:questionnaire": "node validation/run.mjs export-questionnaire",
    "validate:responses": "node validation/run.mjs normalize-responses",
    "validate:montecarlo": "node validation/run.mjs montecarlo",
    "validate:score": "node validation/run.mjs score-personas",
    "validate:capture": "playwright test --config validation/capture/playwright.validation.config.ts",
    "validate:analyze": "node validation/run.mjs analyze"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
